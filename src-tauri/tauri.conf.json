{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropKick",
  "version": "0.1.1",
  "identifier": "com.baekmac.dropkick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DropKick",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 baekmac",
    "fileAssociations": [
      {
        "ext": [
          "dropkick"
        ],
        "name": "DropKick 프로젝트",
        "description": "DropKick 시나리오 프로젝트",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.baekmac.dropkick.project",
          "conformsTo": [
            "com.apple.package",
            "public.composite-content"
          ]
        }
      }
    ],
    "shortDescription": "한글 시나리오 작성 앱",
    "longDescription": "할리우드 형식의 한글 시나리오를 쓰고, 페이지·PDF·통계와 메모·인물 설정을 함께 관리하는 맥 앱",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QUQ0RkU4MDM3N0VEMjYKUldRbTdYY0Q2RSt0U0RDUUU1V2thdWd3cklRQmxTckpFV003c2JSeXhCTDI1ZCtoQUc1YkttalQK",
      "endpoints": [
        "https://github.com/gotgam100/DropKick_releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
